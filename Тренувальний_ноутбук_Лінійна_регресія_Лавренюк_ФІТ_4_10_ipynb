      "source": [
        "# Самостійне завдання 3: метрики для baseline та LinearRegression\n",
        "# Підготовка залежностей, щоб комірка працювала навіть після перезапуску середовища\n",
        "# або якщо попередні комірки ще не запускалися.\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.datasets import load_diabetes\n",
        "from sklearn.dummy import DummyRegressor\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "if \"X\" not in globals() or \"y\" not in globals():\n",
        "    diabetes = load_diabetes(as_frame=True)\n",
        "    X = diabetes.data.copy()\n",
        "    y = diabetes.target.copy()\n",
        "\n",
        "if \"RANDOM_STATE\" not in globals():\n",
        "    RANDOM_STATE = 42\n",
        "\n",
        "# Якщо розбиття даних або прогнози відсутні, створюємо їх тут.\n",
        "if any(name not in globals() for name in [\"X_train\", \"X_test\", \"y_train\", \"y_test\"]):\n",
        "    X_train, X_test, y_train, y_test = train_test_split(\n",
        "        X, y, test_size=0.2, random_state=RANDOM_STATE\n",
        "    )\n",
        "\n",
        "if \"baseline_pred\" not in globals():\n",
        "    baseline = DummyRegressor(strategy=\"mean\")\n",
        "    baseline.fit(X_train, y_train)\n",
        "    baseline_pred = baseline.predict(X_test)\n",
        "\n",
        "if \"linear_pred\" not in globals():\n",
        "    linear = LinearRegression()\n",
        "    linear.fit(X_train, y_train)\n",
        "    linear_pred = linear.predict(X_test)\n",
        "\n",
        "def manual_metrics(y_true, y_pred):\n",
        "    y_true = np.asarray(y_true)\n",
        "    y_pred = np.asarray(y_pred)\n",
        "    errors = y_true - y_pred\n",
        "    mae_value = np.mean(np.abs(errors))\n",
        "    rmse_value = np.sqrt(np.mean(errors ** 2))\n",
        "    ss_res = np.sum(errors ** 2)\n",
        "    ss_tot = np.sum((y_true - np.mean(y_true)) ** 2)\n",
        "    r2_value = 1 - ss_res / ss_tot if ss_tot != 0 else float(\"nan\")\n",
        "    return {\"MAE\": mae_value, \"RMSE\": rmse_value, \"R2\": r2_value}\n",
        "\n",
        "display(pd.DataFrame([\n",
        "    {\"model\": \"DummyRegressor\", **manual_metrics(y_test, baseline_pred)},\n",
        "    {\"model\": \"LinearRegression\", **manual_metrics(y_test, linear_pred)},\n",
        "]).set_index(\"model\").round(3))\n"
      ]
    },
