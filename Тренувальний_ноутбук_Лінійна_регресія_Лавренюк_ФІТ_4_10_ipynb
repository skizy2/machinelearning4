      "source": [
        "# Самостійне завдання 4: порівняння поліноміальних моделей\n",
        "# Імпортуємо необхідні бібліотеки, щоб комірка працювала і після перезапуску середовища.\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import PolynomialFeatures, StandardScaler\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_squared_error\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "# Якщо навчальні та тестові дані ще не створені, підготуємо їх.\n",
        "if not all(name in globals() for name in [\"X_p_train\", \"X_p_test\", \"y_p_train\", \"y_p_test\"]):\n",
        "    rng = np.random.default_rng(42)\n",
        "    X_poly = np.sort(rng.uniform(-3, 3, 45)).reshape(-1, 1)\n",
        "    y_true_poly = np.sin(X_poly.ravel()) + 0.25 * X_poly.ravel()\n",
        "    y_poly = y_true_poly + rng.normal(0, 0.22, size=len(X_poly))\n",
        "    X_p_train, X_p_test, y_p_train, y_p_test = train_test_split(\n",
        "        X_poly, y_poly, test_size=0.35, random_state=42\n",
        "    )\n",
        "\n",
        "degree_results = []\n",
        "degree_models = {}\n",
        "for degree in [1, 2, 4, 6, 10, 15]:\n",
        "    poly_model = Pipeline([\n",
        "        ('poly', PolynomialFeatures(degree=degree, include_bias=False)),\n",
        "        ('scale', StandardScaler()),\n",
        "        ('reg', LinearRegression())\n",
        "    ])\n",
        "    poly_model.fit(X_p_train, y_p_train)\n",
        "    train_prediction = poly_model.predict(X_p_train)\n",
        "    test_prediction = poly_model.predict(X_p_test)\n",
        "    train_rmse = np.sqrt(mean_squared_error(y_p_train, train_prediction))\n",
        "    test_rmse = np.sqrt(mean_squared_error(y_p_test, test_prediction))\n",
        "    degree_results.append({\n",
        "        'degree': degree,\n",
        "        'train_rmse': train_rmse,\n",
        "        'test_rmse': test_rmse\n",
        "    })\n",
        "    degree_models[degree] = poly_model\n",
        "\n",
        "degree_table = pd.DataFrame(degree_results).sort_values('degree')\n",
        "display(degree_table.round(4))\n",
        "best_degree_row = degree_table.loc[degree_table['test_rmse'].idxmin()]\n",
        "print(f\"Найменша test RMSE у моделі ступеня {int(best_degree_row['degree'])}: {best_degree_row['test_rmse']:.4f}.\")\n",
        "print(\"Мінімальна train-помилка не гарантує найкращої моделі: складна модель може перенавчитися і гірше узагальнювати дані.\")\n"
      ]
