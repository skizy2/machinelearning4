        "from sklearn.model_selection import train_test_split, KFold, GridSearchCV\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import Ridge, Lasso\n",
        "from sklearn.metrics import mean_squared_error\n",
        "\n",
        "_data6 = load_diabetes(as_frame=True)\n",
        "X_task6, y_task6 = _data6.data, _data6.target\n",
        "X_train_task6, X_test_task6, y_train_task6, y_test_task6 = train_test_split(\n",
        "    X_task6, y_task6, test_size=0.2, random_state=42\n",
        ")\n",
        "cv_task6 = KFold(n_splits=5, shuffle=True, random_state=42)\n",
        "\n",
        "ridge_search_model_task6 = Pipeline([('scale', StandardScaler()), ('reg', Ridge())])\n",
        "ridge_param_grid_task6 = {'reg__alpha': np.logspace(0, 5, 13)}\n",
        "ridge_search_task6 = GridSearchCV(\n",
        "    ridge_search_model_task6, param_grid=ridge_param_grid_task6,\n",
        "    scoring='neg_root_mean_squared_error', cv=cv_task6, n_jobs=-1\n",
        ")\n",
        "ridge_search_task6.fit(X_train_task6, y_train_task6)\n",
        "\n",
        "lasso_search_model = Pipeline([('scale', StandardScaler()), ('reg', Lasso(max_iter=50000))])\n",
        "lasso_param_grid = {'reg__alpha': np.logspace(-4, 1, 15)}\n",
        "lasso_search = GridSearchCV(\n",
        "    lasso_search_model, param_grid=lasso_param_grid,\n",
        "    scoring='neg_root_mean_squared_error', cv=cv_task6, n_jobs=-1\n",
        ")\n",
        "lasso_search.fit(X_train_task6, y_train_task6)\n",
        "lasso_best_pred = lasso_search.predict(X_test_task6)\n",
        "ridge_best_pred = ridge_search_task6.predict(X_test_task6)\n",
        "print(\"Найкращий Lasso:\", lasso_search.best_params_)\n",
        "print(f\"Lasso CV RMSE: {-lasso_search.best_score_:.3f}; test RMSE: {np.sqrt(mean_squared_error(y_test_task6, lasso_best_pred)):.3f}\")\n",
