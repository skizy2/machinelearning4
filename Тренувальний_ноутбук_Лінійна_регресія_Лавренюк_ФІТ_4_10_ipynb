        "# Самостійне завдання 2: ручне обчислення коефіцієнтів\n",
        "x2 = np.array([2, 4, 6, 8, 10], dtype=float)\n",
        "y2 = np.array([7, 11, 16, 19, 25], dtype=float)\n",
        "x2_bar, y2_bar = x2.mean(), y2.mean()\n",
        "b1_2 = np.sum((x2 - x2_bar) * (y2 - y2_bar)) / np.sum((x2 - x2_bar) ** 2)\n",
        "b0_2 = y2_bar - b1_2 * x2_bar\n",
        "check_model_2 = LinearRegression().fit(x2.reshape(-1, 1), y2)\n",
        "print(f\"x̄ = {x2_bar:.3f}, ȳ = {y2_bar:.3f}\")\n",
        "print(f\"Ручний розрахунок: b0 = {b0_2:.3f}, b1 = {b1_2:.3f}\")\n",
        "print(f\"LinearRegression: b0 = {check_model_2.intercept_:.3f}, b1 = {check_model_2.coef_[0]:.3f}\")\n",
        "print(\"Ручний розрахунок збігається з результатом sklearn.\")"
      ]
