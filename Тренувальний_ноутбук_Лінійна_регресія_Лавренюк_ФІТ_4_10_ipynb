        "    - 500 * housing_task['age'].fillna(housing_task['age'].median())\n",
        "    + housing_task['district'].map({'center': 40000, 'north': 12000, 'south': 0})\n",
        "    + _rng7.normal(0, 12000, _n7)\n",
        ")\n",
        "\n",
        "# Базова модель без ознаки condition для чесного порівняння на тому самому розбитті.\n",
        "Xh_train, Xh_test, yh_train, yh_test = train_test_split(\n",
        "    housing_task, price_task, test_size=0.2, random_state=42\n",
        ")\n",
        "numeric_features_task = ['area', 'rooms', 'age']\n",
        "categorical_features_base = ['district']\n",
        "preprocessor_base = ColumnTransformer([\n",
        "    ('num', Pipeline([('imputer', SimpleImputer(strategy='median')), ('scale', StandardScaler())]), numeric_features_task),\n",
        "    ('cat', Pipeline([('imputer', SimpleImputer(strategy='most_frequent')), ('onehot', OneHotEncoder(handle_unknown='ignore'))]), categorical_features_base),\n",
        "])\n",
        "base_housing_model_task = Pipeline([('preprocess', preprocessor_base), ('reg', Ridge(alpha=1.0))])\n",
        "base_housing_model_task.fit(Xh_train, yh_train)\n",
        "base_housing_pred_task = base_housing_model_task.predict(Xh_test)\n",
        "\n",
        "# Додаємо категорію стану житла та оцінюємо модель з новою ознакою.\n",
        "housing_task_with_condition = housing_task.copy()\n",
        "housing_task_with_condition['condition'] = np.select(\n",
        "    [housing_task_with_condition['age'] < 10, housing_task_with_condition['age'] < 35],\n",
        "    ['new', 'good'], default='needs_repair'\n",
        ")\n",
        "Xc_train, Xc_test, yc_train, yc_test = train_test_split(\n",
        "    housing_task_with_condition, price_task, test_size=0.2, random_state=42\n",
        ")\n",
        "categorical_features_task = ['district', 'condition']\n",
        "preprocessor_task = ColumnTransformer([\n",
        "    ('num', Pipeline([('imputer', SimpleImputer(strategy='median')), ('scale', StandardScaler())]), numeric_features_task),\n",
        "    ('cat', Pipeline([('imputer', SimpleImputer(strategy='most_frequent')), ('onehot', OneHotEncoder(handle_unknown='ignore'))]), categorical_features_task),\n",
        "])\n",
        "housing_model_task = Pipeline([('preprocess', preprocessor_task), ('reg', Ridge(alpha=1.0))])\n",
        "housing_model_task.fit(Xc_train, yc_train)\n",
        "housing_pred_task = housing_model_task.predict(Xc_test)\n",
        "print(f\"Test RMSE без condition: {np.sqrt(mean_squared_error(yh_test, base_housing_pred_task)):.3f}\")\n",
        "print(f\"Test RMSE з condition: {np.sqrt(mean_squared_error(yc_test, housing_pred_task)):.3f}\")\n",
        "print(\"Категоріальну ознаку condition включено в ColumnTransformer через OneHotEncoder.\")"
      ]
